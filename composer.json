{
    "name": "amjadiqbal/laravel-mysql-advisor",
    "description": "Read-only MySQL and MariaDB health advisor for Laravel: finds unused, redundant and missing indexes, full table scans, slow and N+1 queries, fragmented tables and server pressure, with the exact SQL or migration to fix each one. Artisan report with a CI exit code plus a Blade dashboard.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "amjadiqbal",
        "laravel",
        "laravel-package",
        "mysql",
        "mariadb",
        "database",
        "database-health",
        "database-performance",
        "performance",
        "indexes",
        "unused-indexes",
        "query-optimization",
        "slow-queries",
        "n-plus-one",
        "performance-schema"
    ],
    "homepage": "https://github.com/amjadiqbal/laravel-mysql-advisor",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-mysql-advisor/issues",
        "source": "https://github.com/amjadiqbal/laravel-mysql-advisor",
        "docs": "https://github.com/amjadiqbal/laravel-mysql-advisor#readme"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\MysqlAdvisor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\MysqlAdvisor\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\MysqlAdvisor\\MysqlAdvisorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "pint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    }
}
